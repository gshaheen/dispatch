{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dispatch",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "default"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dispatch-db",
      "database_id": "90064b71-7069-42ff-8476-87248d80b2f9"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
